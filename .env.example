# Structured JSON logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Start safe. Both must be true before an automatic real order can be sent.
LIVE_TRADING=false
AUTO_TRADING=false

# Long random secret required in X-Signal-Secret for /auto/* endpoints.
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Manual + automatic risk limits
MAX_TRADE_USDC=100
MAX_AUTO_TRADE_USDC=25
MAX_DAILY_BUDGET_USDC=100
MAX_PRICE=0.95
MAX_SPREAD=0.08
# Sports BUYs below this decimal price remain visible but require explicit dashboard approval.
MIN_DECIMAL_ODDS=1.70
AUTO_POLL_SECONDS=30
TRADING_TIMEZONE=Asia/Kuala_Lumpur

# Keep political markets out of assistant-generated automatic execution.
BLOCK_POLITICAL_AUTO=true

# Only needed for real orders. Store locally; never paste into ChatGPT or commit to GitHub.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_DEPOSIT_WALLET=


# Polymarket Combo RFQ trading
# Live Combo acceptance remains OFF unless this is explicitly true.
# Combo BUYs also require LIVE_TRADING=true + AUTO_TRADING=true + the dashboard master switch.
COMBO_TRADING_ENABLED=false
COMBO_MAX_LEGS=8
COMBO_FILL_WAIT_SECONDS=45
# Optional. If omitted on Termux, the executor creates a Builder API key on first Combo use
# and stores it in ~/.config/polymarket-termux/builder_api_key.json with mode 0600.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Maximum time a live BUY may wait for the Termux executor.
# Prevents old sports signals executing after the executor reconnects.
EXECUTOR_BUY_TTL_SECONDS=180

# NFL Telegram capper automation
# New Slam/The Syndicate NFL game picks are polled from the sanitized bridge.
# 1 unit = $10 PROFIT by default. Posted units are profit targets; stake is calculated from the current executable price.
# Slam and Syndicate can override this independently from the dashboard; overrides persist in /app/data/capper_unit_sizes.json.
# Dashboard AUTO % mode defaults to 10% of total wallet value (available USDC + marked positions) and recalculates 1u continuously.
NFL_CAPPER_ENABLED=true
NFL_CAPPER_UNIT_USDC=10
NFL_CAPPER_POLL_SECONDS=15
NFL_CAPPER_MAX_PICK_AGE_SECONDS=180
NFL_CAPPER_RECOVERY_MAX_PICK_AGE_SECONDS=86400
# Disabled by default. When enabled, an exact NFL spread miss may auto-use only the nearest
# same-game spread that is BETTER for the selected team and within this point distance.
NFL_CAPPER_BETTER_SPREAD_FALLBACK_ENABLED=false
NFL_CAPPER_ALT_SPREAD_MAX_POINTS=1.0
# Totals use the nearest strictly safer line when the exact line is unavailable.
# Under moves up, Over moves down, bounded by this distance.
NFL_CAPPER_ALT_TOTAL_MAX_POINTS=2.0
NFL_CAPPER_FEED_WINDOW_MINUTES=1440
NFL_CAPPER_BRIDGE_URL=https://telegram-chatgpt-bridge-production-286a.up.railway.app
# Optional stable Telegram chat IDs for explicit source pinning. Comma-separated.
# Normalized source/source_key aliases are also recognized automatically.
NFL_CAPPER_SLAM_SOURCE_IDS=
NFL_CAPPER_SYNDICATE_SOURCE_IDS=

# College Football Telegram capper
# Mirrors NFL polling/sizing/safety. CFB posted units are also PROFIT targets; stake is calculated from the current executable price.
# Slam and Syndicate can override 1u independently from the dashboard, including AUTO % portfolio sizing (10% default). Preview-only unless live is enabled.
CFB_CAPPER_ENABLED=true
CFB_CAPPER_UNIT_USDC=10
CFB_CAPPER_POLL_SECONDS=15
CFB_CAPPER_MAX_PICK_AGE_SECONDS=180
CFB_CAPPER_RECOVERY_MAX_PICK_AGE_SECONDS=86400
CFB_CAPPER_BRIDGE_URL=https://telegram-chatgpt-bridge-production-286a.up.railway.app
CFB_CAPPER_SLAM_SOURCE_IDS=
CFB_CAPPER_SYNDICATE_SOURCE_IDS=
# Set true to promote CFB from preview to live auto-trading (requires LIVE+AUTO gates).
CFB_CAPPER_LIVE_ENABLED=false

# Optional one-shot safe validation payload. Preview unless CFB_CAPPER_LIVE_ENABLED.
CFB_CAPPER_TEST_PREVIEW_JSON=
# Optional JSON list of parsed, user-verified CFB picks to ingest through the normal capper path during a bridge outage.
CFB_CAPPER_MANUAL_PICKS_JSON=

# NBA PW export ingestion (NBAMonitor Tailnet feed)
# Set the URL to enable NBA polling alongside WNBA.
PW_NBA_EXPORT_URL=

# Termux follows the current dashboard/Railway MAX_AUTO_TRADE_USDC for normal
# order sizing. This is only a high emergency backstop for catastrophic mistakes.
# It should not need to be synchronized with ordinary dashboard cap changes.
EXECUTOR_EMERGENCY_MAX_USDC=500



# Research-only forward executable WNBA PW spread capture
PW_SPREAD_CAPTURE_ENABLED=true
PW_SPREAD_CAPTURE_SAMPLE_SECONDS=1
PW_SPREAD_CAPTURE_WINDOW_SECONDS=300

# Retry count after a matched capper BUY crosses the book but fills zero shares before cancellation.
NFL_CAPPER_NO_FILL_RETRIES=2
CFB_CAPPER_NO_FILL_RETRIES=2
