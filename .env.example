# Start safe. Both must be true before an automatic real order can be sent.
LIVE_TRADING=false
AUTO_TRADING=false

# Long random secret required in X-Signal-Secret for /auto/* endpoints.
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Manual + automatic risk limits
MAX_TRADE_USDC=100
MAX_AUTO_TRADE_USDC=25
MAX_DAILY_BUDGET_USDC=100
MAX_PRICE=0.95
MAX_SPREAD=0.08
AUTO_POLL_SECONDS=30
TRADING_TIMEZONE=Asia/Kuala_Lumpur

# Keep political markets out of assistant-generated automatic execution.
BLOCK_POLITICAL_AUTO=true

# Only needed for real orders. Store locally; never paste into ChatGPT or commit to GitHub.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_DEPOSIT_WALLET=

# Maximum time a live BUY may wait for the Termux executor.
# Prevents old sports signals executing after the executor reconnects.
EXECUTOR_BUY_TTL_SECONDS=180

# NFL Telegram capper automation
# New Slam/The Syndicate NFL game picks are polled from the sanitized bridge.
# 1 unit = $10 by default; explicit posted units >1 multiply this amount.
NFL_CAPPER_ENABLED=true
NFL_CAPPER_UNIT_USDC=10
NFL_CAPPER_POLL_SECONDS=15
NFL_CAPPER_MAX_PICK_AGE_SECONDS=180
NFL_CAPPER_BRIDGE_URL=https://telegram-chatgpt-bridge-production-286a.up.railway.app

# Termux keeps an independent final per-order ceiling. Set this at least as
# high as the largest allowed dashboard auto-trade cap if using multi-unit NFL plays.
EXECUTOR_MAX_USDC=25

